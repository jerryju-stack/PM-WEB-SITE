  "metrics": {
    "revenue": {
      "zh": "营业收入",
      "format": "money",
      "en": "Revenue",
      "basis": "website",
      "unit": "报告币金额",
      "period": "按版本覆盖第 0 期至末期，可按同范围年度或产品下钻",
      "definition": "本项目在所选期间销售各产品取得的收入。",
      "formula": "Σ(各产品各市场销量 × 含已约定件价摊回的净售价 × 当期原币至报告币汇率)，保留年降和单位换算。",
      "sources": [
        "volume",
        "price",
        "full_pl",
        "exec_pl"
      ],
      "mapping": "mapped",
      "example": "虚构项目 A 售 10 件、每件 20 元，B 售 20 件、每件 5 元，全期收入 300.00 元。"
    },
    "operating_profit": {
      "zh": "经营利润",
      "format": "money",
      "en": "Operating Profit",
      "basis": "website",
      "unit": "报告币金额",
      "period": "按版本覆盖第 0 期至末期，可按同范围年度或产品下钻",
      "definition": "按财务批准的全成本管理范围，销售收入扣除归属于本项目的经营成本和费用后剩下的金额。",
      "formula": "同范围已映射收入 − 已映射全成本及经营费用。先确认折旧、分摊、工程净额和税前边界。",
      "sources": [
        "full_pl",
        "operating_bridge"
      ],
      "mapping": "pending_finance",
      "example": "按已核准的示例口径，A 盈利 30 元、B 亏损 6 元，合计经营利润 24.00 元。"
    },
    "operating_margin": {
      "zh": "经营利润率",
      "format": "percent",
      "en": "Operating Margin",
      "basis": "website",
      "unit": "比例",
      "period": "按版本覆盖第 0 期至末期，可按同范围年度或产品下钻",
      "definition": "每一元营业收入中有多少成为同口径经营利润。",
      "formula": "Σ经营利润 / Σ营业收入。收入为 0 返回 zero_denominator，经营利润映射未定返回 pending_finance。",
      "sources": [
        "full_pl",
        "operating_bridge"
      ],
      "mapping": "pending_finance",
      "example": "两款产品利润合计 24 元、收入合计 300 元，项目利润率为 8.00%。"
    },
    "npv": {
      "zh": "净现值",
      "format": "money",
      "en": "Net Present Value (NPV)",
      "basis": "website",
      "unit": "报告币金额",
      "period": "等长年度，第 0 期至末期",
      "definition": "把未来各期项目现金流按本版本折现率折回起算日，加上当天的投入或收款。",
      "formula": "Σ CF[t]/(1+r)^t，t 从 0 开始。",
      "sources": [
        "local_cash",
        "project_cash"
      ],
      "mapping": "mapped_cqa_cash",
      "example": "第 0 期支出 100 元，以后两年末各收 60 元，年折现率 10%，净现值为 4.13 元。"
    },
    "irr": {
      "zh": "内部收益率",
      "format": "percent",
      "en": "Internal Rate of Return (IRR)",
      "basis": "website",
      "unit": "年有效收益率",
      "period": "等长年度，第 0 期至末期",
      "definition": "使合并项目现金流净现值为零的年收益率。",
      "formula": "求 r > −1 使 Σ CF[t]/(1+r)^t = 0，状态见 policy.irr。",
      "sources": [
        "local_cash",
        "project_cash"
      ],
      "mapping": "mapped_cqa_cash",
      "example": "现金流 −100、60、60 元的 IRR 为 13.07%。两笔均为支出时显示「无可解释解」。"
    },
    "payback_period": {
      "zh": "投资回收期",
      "format": "years",
      "en": "Payback Period",
      "basis": "website",
      "unit": "年",
      "period": "等长年度，第 0 期至末期",
      "definition": "从第 0 期算起，累计收回最初资金缺口需要多久。",
      "formula": "按 policy.payback 对合并未折现现金流的首次回收期线性插值。",
      "sources": [
        "project_cash",
        "local_cash"
      ],
      "mapping": "derived",
      "example": "−100、60、60 元在第 1 年末尚差 40 元，第 2 年收回，回收期为 1 + 40/60 = 1.67 年。"
    },
    "peak_funding_requirement": {
      "zh": "峰值资金需求",
      "format": "money",
      "en": "Peak Funding Requirement",
      "basis": "website",
      "unit": "报告币金额及首次发生期",
      "period": "等长年度，第 0 期至末期",
      "definition": "项目累计现金流在最紧张时还需要多少资金，并指出首次出现该缺口的期间。",
      "formula": "max(0, −min S[t])，各期从第 0 期起累计。",
      "sources": [
        "project_cash",
        "local_cash"
      ],
      "mapping": "derived",
      "example": "−100、60、60 元的累计为 −100、−40、20 元，最大缺口为 100.00 元，首次在第 0 期。"
    },
    "ebit": {
      "zh": "息税前利润",
      "format": "money",
      "en": "Earnings Before Interest and Taxes (EBIT)",
      "basis": "website",
      "unit": "报告币金额",
      "period": "按版本覆盖第 0 期至末期，可按同范围年度或产品下钻",
      "definition": "利息和所得税之前的利润，经营与非经营项目按项目财务政策界定。",
      "formula": "按批准的税前利润范围加回利息净额。与经营利润的差项逐项列明。",
      "sources": [
        "operating_bridge"
      ],
      "mapping": "pending_finance"
    },
    "nopat": {
      "zh": "税后经营利润",
      "format": "money",
      "en": "Net Operating Profit After Tax (NOPAT)",
      "basis": "website",
      "unit": "报告币金额",
      "period": "分年或同范围全期",
      "definition": "经营利润承担对应经营税额后的金额。",
      "formula": "已核准经营利润 − 相应经营税额。按版本明确亏损税盾。",
      "sources": [
        "operating_bridge",
        "tax_assets"
      ],
      "mapping": "pending_finance"
    },
    "capex": {
      "zh": "资本性支出",
      "format": "money",
      "en": "Capital Expenditure (CAPEX)",
      "basis": "website",
      "unit": "报告币金额",
      "period": "按投入或付款期注明",
      "definition": "用于取得或改良长期资产的毛支出。",
      "formula": "汇总合格资产投资。分别记录新增、已有资产分摊、付款及客户补偿。",
      "sources": [
        "investment"
      ],
      "mapping": "mapped_cqa_gross"
    },
    "nwc": {
      "zh": "净营运资金",
      "format": "money",
      "en": "Net Working Capital (NWC)",
      "basis": "website",
      "unit": "报告币期末余额",
      "period": "各期末",
      "definition": "日常经营占用的经营性流动资产扣除经营性流动负债。",
      "formula": "按确认范围合计存货、应收、其他经营资产，扣应付等经营负债。现金流使用本期相对上期的增减。",
      "sources": [
        "working_capital"
      ],
      "mapping": "mapped_cqa_incremental"
    },
    "fcff": {
      "zh": "企业自由现金流",
      "format": "money",
      "en": "Free Cash Flow to the Firm (FCFF)",
      "basis": "website",
      "unit": "报告币金额",
      "period": "各期",
      "definition": "项目经营、税款、再投资之后，可供资本提供者的现金。",
      "formula": "NOPAT + 非现金折旧摊销 − 毛资本支出 − ΔNWC，加减经核准的项目现金调整。",
      "sources": [
        "operating_bridge",
        "local_cash",
        "investment"
      ],
      "mapping": "pending_finance"
    },
    "roic": {
      "zh": "投入资本回报率",
      "format": "percent",
      "en": "Return on Invested Capital (ROIC)",
      "basis": "website",
      "unit": "比例",
      "period": "同一年度",
      "definition": "该期税后经营利润相对平均投入资本的回报。",
      "formula": "NOPAT / 平均(期初投入资本,期末投入资本)。分母为零或投入资本范围未定须标状态。",
      "sources": [
        "tax_assets",
        "operating_bridge"
      ],
      "mapping": "pending_finance"
    },
    "etc": {
      "zh": "剩余完工成本估算",
      "format": "money",
      "en": "Estimate to Complete (ETC)",
      "basis": "website",
      "unit": "报告币金额",
      "period": "数据截止日以后至完工",
      "definition": "完成剩余范围预计还需投入的成本。",
      "formula": "Σ剩余工作预测，剔除已由确认实绩覆盖的部分。",
      "sources": [
        "budget_actual"
      ],
      "mapping": "to_collect"
    },
    "eac": {
      "zh": "预计完工成本",
      "format": "money",
      "en": "Estimate at Completion (EAC)",
      "basis": "website",
      "unit": "报告币金额",
      "period": "截止日及同一完工范围",
      "definition": "按当前执行情况，预计完工总共花多少钱。",
      "formula": "截至期已确认实绩 + 同范围 ETC。预计完工差额 = 批准预算 − EAC。",
      "sources": [
        "budget_actual"
      ],
      "mapping": "to_collect"
    },
    "cqa.dvp": {
      "zh": "直接变动利润",
      "format": "money",
      "en": "Direct Variable Profit (DVP)",
      "basis": "cqa_full",
      "unit": "原币千元",
      "period": "原年度及全期",
      "definition": "收入扣除直接材料、直接人工和净报废后的利润。",
      "formula": "186 − 190 = 191。增量对应 265 − 269 = 270。",
      "sources": [
        "full_pl",
        "incremental_pl"
      ],
      "mapping": "mapped"
    },
    "cqa.mpbitri": {
      "zh": "CQA 全成本管理利润",
      "format": "money",
      "en": "MPBITRI (Full Cost)",
      "basis": "cqa_full",
      "unit": "原币千元",
      "period": "按版本覆盖第 0 期至末期，可按同范围年度或产品下钻",
      "definition": "全成本工厂利润再扣事业部等分摊及净应用工程费用，是历史管理利润。",
      "formula": "204 − 209 − 210 = 212。",
      "sources": [
        "full_pl",
        "engineering"
      ],
      "mapping": "mapped"
    },
    "cqa.mpbitri_margin": {
      "zh": "CQA 全成本管理利润率",
      "format": "percent",
      "en": "MPBITRI %",
      "basis": "cqa_full",
      "unit": "比例",
      "period": "按版本覆盖第 0 期至末期，可按同范围年度或产品下钻",
      "definition": "每单位收入对应的原表全成本管理利润。",
      "formula": "Σ212 / Σ186，含第 0 期费用。",
      "sources": [
        "full_pl",
        "exec_pl"
      ],
      "mapping": "mapped"
    },
    "cqa.ros": {
      "zh": "CQA 销售回报率",
      "format": "percent",
      "en": "Return on Sales (ROS)",
