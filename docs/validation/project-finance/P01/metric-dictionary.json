  "comparison": {
    "columns": [
      "批准基线",
      "当前预测",
      "差额",
      "候选预览（编辑时）"
    ],
    "delta": "当前预测减批准基线。预览明确显示编辑前版本，差额为候选减编辑前。同币种、期间、产品范围及财务口径可比后计算。",
    "units": "金额差带符号及币种单位。利润率和 IRR 差用百分点。回收期差用年。峰值同时列首次发生期。"
  },
  "states": {
    "ok": "有效，含经核实的数值零",
    "no_activity": "无业务，来源明确该范围未启用",
    "missing_input": "缺数据、公式缓存为空或原表错误",
    "pending_finance": "待财务核对口径",
    "zero_denominator": "分母为零",
    "invalid_rate": "折现率缺乏有效定义或不大于 −100%",
    "no_irr": "全零或没有正负两种现金流，收益率无可解释解",
    "ambiguous_irr": "多次变号，收益率唯一性待核对",
    "solver_failed": "求解未收敛或残差超限",
    "not_recovered": "全期未回收",
    "no_funding_required": "全期无资金缺口，金额或年数为 0",
    "recrossed": "曾回收，之后又有资金缺口，保留首次回收值并提示"
  },
  "policy": {
    "period": "完整保留原期间标签。Year 0 是估值时点，投入立即计入。第 1 至第 n 期按各年末折现，零现金流年份也占一期。项目先按同一币种、期间逐产品合并，每笔共用项或内部抵销只计一次。",
    "discount": "年有效折现率用小数存储，r > −1。零和有效负利率可计算，缺值返回 missing_input。档案项目比较取 project_cash 的 rate，逐一核产品 local_cash 的 rate。演示用 10%。每个新版本须有自己的折现依据。",
    "irr": "忽略零项判变号，期间本身仍保留。在 r > −1 内求解。同号或全零返回 no_irr。一次变号可返回唯一根（含负收益率和零）。多次变号在唯一性获证前返回 ambiguous_irr。未收敛或经折现的残差超出金额容差时返回 solver_failed。所有无结果状态的值均为 null。",
    "payback": "令 S[t] 为第 0 期起的未折现累计。如果从未出现负累计则为 0 年。首次负累计之后，取首个 S[t] ≥ 0 的期末，值为 t−1 + (−S[t−1])/CF[t]。恰好为零取整期。零流量的等待年占一期。至末仍未首次回收则返回 not_recovered、值 null。其后再为负标记 recrossed。",
    "peak": "金额为 max(0, −min S[t])。并列最低点取首次出现的原期间。全期无缺口时金额为 0、发生期为 null。输入不齐时不从残缺曲线求资金指标。",
    "precision": "先用原精度合计、折现、换算、插值和求差，只在显示的最后一步按十进制四舍五入（中点远离零）。核对原缓存用未显示舍入的值，先换到同币种同量纲。屏上舍入值不作核对输入。",
    "displayDecimals": {
      "money": 2,
      "unit_price": 4,
      "percent": 2,
      "years": 2,
      "count": 0,
      "seconds": 2
    },
    "absoluteTolerance": {
      "money_in_major_currency": "0.01",
      "money_in_thousands": "0.00001",
      "unit_price": "0.000001",
      "ratio_as_fraction": "0.00000001",
      "years": "0.000001",
      "count_or_period": "0"
    },
    "variance": "逐产品、逐期及全期分别取绝对差，等于阈值通过。异常报源行和期间。缺数、状态、方向、币种、倍率、产品集合与首次最低期须精确匹配，不能靠容差放行。"
  },
