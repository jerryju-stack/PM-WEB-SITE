{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "/theme-control.js": ["./src/theme-control.ts"],
      "/finance.js": ["./src/finance.ts"],
      "/finance-view.js": ["./src/finance-view.ts"],
      "/finance-impact.js": ["./src/finance-impact.ts"],
      "/finance-business-view.js": ["./src/finance-business-view.ts"],
      "/finance-operations.js": ["./src/finance-operations.ts"],
      "/finance-development.js": ["./src/finance-development.ts"],
      "/finance-capital.js": ["./src/finance-capital.ts"],
      "/finance-budget.js": ["./src/finance-budget.ts"],
      "/finance-compare.js": ["./src/finance-compare.ts"],
      "/finance-fx.js": ["./src/finance-fx.ts"],
      "/finance-preview-state.js": ["./src/finance-preview-state.ts"],
      "/timing-layout.js": [
        "./src/timing-layout.ts"
      ],
      "/timing-io.js": [
        "./src/timing-io.ts"
      ],
      "/timing-history.js": [
        "./src/timing-history.ts"
      ],
      "/access-ui.js": [
        "./src/access-ui.ts"
      ],
      "/timing.js": [
        "./src/timing.ts"
      ],
      "/schedule.js": [
        "./lib/schedule.ts"
      ],
      "/drafts.js": [
        "./src/drafts.ts"
      ],
      "/task-index.js": [
        "./lib/task-index.ts"
      ]
    }
  },
  "include": [
    "server.ts",
    "lib/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
