{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "/access-ui.js": ["./src/access-ui.ts"],
      "/timing.js": [
        "./src/timing.ts"
      ],
      "/schedule.js": [
        "./lib/schedule.ts"
      ],
      "/drafts.js": [
        "./src/drafts.ts"
      ]
    }
  },
  "include": [
    "server.ts",
    "lib/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
